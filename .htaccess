# Per-collection share/preview pages: /c/<txid> → share.php (server-rendered Open Graph for link crawlers).
# Everything else (the SPA at /, bundle.js, /brand, /og/*.jpg …) is served normally as static files.
RewriteEngine On
RewriteRule ^c/([0-9a-fA-F]{64})/?$ share.php?c=$1 [L,QSA]
# Shortened share links: /s/<code> → share.php resolves the code to {txid, holder, aff} (public only).
RewriteRule ^s/([0-9A-Za-z]{1,16})/?$ share.php?s=$1 [L,QSA]

# Don't expose directory listings (e.g. of the /og cache). Its files are only public cover JPEGs +
# title/description JSON, so direct access is harmless — just no browsable index.
Options -Indexes

# Module files are JavaScript; a browser refuses to run a module served as any other type.
AddType text/javascript .mjs

# ── Cache policy: never let a returning visitor run a STALE app ────────────────────────────────────
# index.html and the app's script files have fixed names, so without this a browser can keep week-old copies
# from disk cache and never recheck — an outdated client against newer on-chain formats can break features
# (e.g. "View content" on a fresh acquisition), and a cached file whose hash no longer matches index.html is
# refused. Force them to revalidate every load; ETag/304 makes that near-free when nothing changed.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Content-addressed / rarely-changing assets can cache hard (covers/brand art are effectively immutable).
  <FilesMatch "\.(woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The wallet page runs only this site's own script files: nothing injected into it runs, nor a publisher's SVG or
  # HTML opened from it (a blob: page takes this policy). Only index.html: share.php's redirect is an inline script.
  <Files "index.html">
    Header set Content-Security-Policy "script-src 'self'"
  </Files>
</IfModule>
